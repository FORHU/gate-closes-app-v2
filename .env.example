ENVIRONMENT=dev
APP_NAME=Gate Closes (Dev)
BASE_URL=http://10.0.2.2:3006/api
ENABLE_LOGGING=true
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here

