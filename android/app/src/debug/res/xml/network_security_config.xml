<?xml version="1.0" encoding="utf-8"?>
<!-- Debug and profile builds only: plain HTTP to a local API and MinIO
     (adb reverse, the emulator's host alias, or the dev PC's LAN IP from a
     phone; the IP changes between networks, so no fixed list). Dart's HTTP
     client ignores this policy, but Android's media player (voice notes)
     enforces it. Release builds keep the default: HTTPS only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
